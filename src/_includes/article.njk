{% extends "base.njk" %}
{% block title %}{{ title }}{% endblock %}

{% block content %}
<article class="post" itemscope itemtype="//schema.org/BlogPosting">
    <h1 class="post-title" itemprop="name"><a href="{{ page.url }}">{{ title }}</a></h1>
    <time class="post-date" datetime="{{ date | htmlDateString }}" itemprop="datePublished">{{ date | readableDate }}</time>

    {{ content | safe }}
</article>
{% endblock %}
