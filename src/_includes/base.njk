<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>{% block title %}{% endblock %} - Michael Wales</title>
    <meta name="author" content="{{ site.author }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    {% set pageDescription = description or site.description %}
    {% set ogType = "article" if (tags and "articles" in tags) else "website" %}
    <meta name="description" content="{{ pageDescription }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">

    <meta property="og:type" content="{{ ogType }}">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:title" content="{{ title or site.title }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ image or site.image }}">
    <meta property="og:image:alt" content="{{ site.author }}">
    {%- if ogType == "article" %}
    <meta property="article:published_time" content="{{ page.date | dateToRfc3339 }}">
    {%- endif %}

    <meta name="twitter:card" content="summary">
    <meta name="twitter:site" content="@{{ site.twitter }}">
    <meta name="twitter:creator" content="@{{ site.twitter }}">

    <link rel="alternate" type="application/atom+xml" title="{{ site.title }} — Atom Feed" href="/feed.xml">

    <link rel="stylesheet" href="/styles/normalize.css">
    <link rel="stylesheet" href="/styles/ionicons.min.css">
    <link rel="stylesheet" href="/styles/prism-github.css">
    <link rel="stylesheet" href="/styles/style.css">

    <script type="text/javascript" src="https://use.typekit.net/byn8skt.js"></script>
    <script type="text/javascript">try{Typekit.load();}catch(e){}</script>
</head>

<body class="page" itemscope itemtype="//schema.org/Blog">
    <div class="sidebar">
        <header class="header" itemscope itemtype="//schema.org/Person">
            <h1 class="header-title" itemprop="name"><a href="/">
                <span>M</span>ichael <span>W</span>ales
            </a></h1>
            <h2 class="header-subtitle" itemprop="jobTitle">Engineering Leader &amp; Open Source Advocate</h2>
        </header>

        <nav>
            <ul class="nav">
                <li class="nav-item">
                   <a href="/resume/" title="Resume" aria-label="Resume"><i class="ion-document-text" aria-hidden="true"></i><span>Resume</span></a>
                </li>
                <li class="nav-item">
                    <a href="/about/" title="About" aria-label="About"><i class="ion-information-circled" aria-hidden="true"></i><span>About</span></a>
                </li>
            </ul>
        </nav>
    </div>

    <main>
        {% block content %}
        {% endblock %}
    </main>

    <footer>

    </footer>
</body>
</html>
