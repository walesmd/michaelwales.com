<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <title>{% block title %}{% endblock %} - Michael Wales</title>
    <meta name="author" content="Michael Wales">
    <meta name="description" content="Engineering leader with 20+ years building teams and products, now Senior Director of AI Programs at CodePath—writing on leadership, learning, and technology.">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="stylesheet" href="/styles/normalize.css">
    <link rel="stylesheet" href="/styles/ionicons.min.css">
    <link rel="stylesheet" href="/styles/prism-github.css">
    <link rel="stylesheet" href="/styles/style.css">

    <script type="text/javascript" src="https://use.typekit.net/byn8skt.js"></script>
    <script type="text/javascript">try{Typekit.load();}catch(e){}</script>
</head>

<body class="page" itemscope itemtype="//schema.org/Blog">
    <div class="sidebar">
        <header class="header" itemscope itemtype="//schema.org/Person">
            <h1 class="header-title" itemprop="name"><a href="/">
                <span>M</span>ichael <span>W</span>ales
            </a></h1>
            <h2 class="header-subtitle" itemprop="jobTitle">Engineering Leader &amp; Open Source Advocate</h2>
        </header>

        <nav>
            <ul class="nav">
                <li class="nav-item">
                   <a href="/resume/" title="Resume"><i class="ion-document-text"></i><span>Resume</span></a>
                </li>
                <li class="nav-item">
                    <a href="/about/" title="About"><i class="ion-information-circled"></i><span>About</span></a>
                </li>
            </ul>
        </nav>
    </div>

    <main>
        {% block content %}
        {% endblock %}
    </main>

    <footer>

    </footer>
</body>
</html>
