<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <title>{% if title %}{{ title }} - {% endif %}{{ site.title }}</title>
    <meta name="author" content="{{ site.author }}">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <link rel="preconnect" href="https://use.typekit.net" crossorigin>

    {%- if eleventy.env.runMode == "build" and site.clarity %}
    <!-- Microsoft Clarity -->
    <script type="text/javascript">
        (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
        })(window, document, "clarity", "script", "{{ site.clarity }}");
    </script>
    {%- endif %}

    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    {% set pageDescription = description or site.description %}
    {% set ogType = "article" if (tags and "articles" in tags) else "website" %}
    <meta name="description" content="{{ pageDescription }}">
    <link rel="canonical" href="{{ site.url }}{{ page.url }}">

    <meta property="og:type" content="{{ ogType }}">
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:title" content="{{ title or site.title }}">
    <meta property="og:description" content="{{ pageDescription }}">
    <meta property="og:url" content="{{ site.url }}{{ page.url }}">
    <meta property="og:image" content="{{ image or site.image }}">
    <meta property="og:image:alt" content="{{ site.author }}">
    {%- if ogType == "article" %}
    <meta property="article:published_time" content="{{ page.date | dateToRfc3339 }}">
    {%- endif %}

    <meta name="twitter:card" content="summary">
    <meta name="twitter:site" content="@{{ site.twitter }}">
    <meta name="twitter:creator" content="@{{ site.twitter }}">

    <link rel="alternate" type="application/atom+xml" title="{{ site.title }} — Atom Feed" href="/feed.xml">

    <link rel="stylesheet" href="https://use.typekit.net/byn8skt.css">
    <link rel="stylesheet" href="/styles/normalize.css">
    {%- if content and "language-" in (content | string) %}
    <link rel="stylesheet" href="/styles/prism-github.css">
    {%- endif %}
    <link rel="stylesheet" href="/styles/style.css">
    {#- normalize: page.url is `false` for permalink:false (unpublished) pages -#}
    {%- set navUrl = page.url or "" %}
    {%- if "/projects/" in navUrl %}
    <link rel="stylesheet" href="/styles/tokens.css">
    <link rel="stylesheet" href="/styles/projects.css">
    {%- elif (navUrl == "/") or ("/topics/" in navUrl) %}
    <link rel="stylesheet" href="/styles/tokens.css">
    <link rel="stylesheet" href="/styles/topics.css">
    {%- endif %}
</head>

<body class="page" itemscope itemtype="https://schema.org/Blog">
    <div class="sidebar">
        <header class="header" itemscope itemtype="https://schema.org/Person">
            <h1 class="header-title" itemprop="name"><a href="/">
                <span>M</span>ichael <span>W</span>ales
            </a></h1>
            <h2 class="header-subtitle" itemprop="jobTitle">Engineering Leader &amp; Open Source Advocate</h2>
        </header>

        <nav>
            {%- set isArticles = (navUrl == "/") or ("/articles/" in navUrl) or ("/topics/" in navUrl) %}
            {%- set isProjects = "/projects/" in navUrl %}
            {%- set isAbout = "/about/" in navUrl %}
            {%- set isResume = "/resume/" in navUrl %}
            <ul class="nav">
                <li class="nav-item">
                    <a href="/" title="Articles" aria-label="Articles" class="{{ 'is-active' if isArticles else '' }}"{% if isArticles %} aria-current="page"{% endif %}>{% icon "newspaper" %}<span>Articles</span></a>
                </li>
                <li class="nav-item">
                    <a href="/projects/" title="Projects" aria-label="Projects" class="{{ 'is-active' if isProjects else '' }}"{% if isProjects %} aria-current="page"{% endif %}>{% icon "squares-2x2" %}<span>Projects</span></a>
                </li>
                <li class="nav-item">
                    <a href="/about/" title="About" aria-label="About" class="{{ 'is-active' if isAbout else '' }}"{% if isAbout %} aria-current="page"{% endif %}>{% icon "information-circle" %}<span>About</span></a>
                </li>
                <li class="nav-item">
                    <a href="/resume/" title="Resume" aria-label="Resume" class="{{ 'is-active' if isResume else '' }}"{% if isResume %} aria-current="page"{% endif %}>{% icon "document-text" %}<span>Resume</span></a>
                </li>
            </ul>
        </nav>
    </div>

    <main>
        {% block content %}
        {% endblock %}
    </main>
</body>
</html>
